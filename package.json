{
  "name": "thermoshift-workspace",
  "private": true,
  "version": "1.5.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10.9 <11"
  },
  "workspaces": ["apps/web", "apps/desktop"],
  "scripts": {
    "dev": "npm --workspace @thermoshift/web run dev",
    "build": "npm --workspace @thermoshift/web run build",
    "test": "npm --workspace @thermoshift/web run test",
    "lint": "npm --workspace @thermoshift/web run lint",
    "typecheck": "npm --workspace @thermoshift/web run typecheck",
    "e2e": "npm --workspace @thermoshift/web run e2e",
    "verify:versions": "node scripts/check-versions.mjs",
    "verify:web-budget": "node scripts/check-web-budget.mjs",
    "verify:native-config": "node scripts/verify-native-config.mjs",
    "native:info": "npm --workspace @thermoshift/desktop run info",
    "desktop:dev": "npm --workspace @thermoshift/desktop run dev",
    "desktop:build": "npm --workspace @thermoshift/desktop run build",
    "android:init": "npm --workspace @thermoshift/desktop run android:init",
    "android:dev": "npm --workspace @thermoshift/desktop run android:dev",
    "android:dev:host": "npm --workspace @thermoshift/desktop run android:dev:host",
    "android:run": "npm --workspace @thermoshift/desktop run android:run",
    "android:build": "npm --workspace @thermoshift/desktop run android:build",
    "android:apk": "npm --workspace @thermoshift/desktop run android:apk",
    "android:aab": "npm --workspace @thermoshift/desktop run android:aab",
    "ios:init": "npm --workspace @thermoshift/desktop run ios:init",
    "ios:dev": "npm --workspace @thermoshift/desktop run ios:dev",
    "ios:dev:host": "npm --workspace @thermoshift/desktop run ios:dev:host",
    "ios:run": "npm --workspace @thermoshift/desktop run ios:run",
    "ios:build": "npm --workspace @thermoshift/desktop run ios:build",
    "ios:build:unsigned": "npm --workspace @thermoshift/desktop run ios:build:unsigned"
  }
}
