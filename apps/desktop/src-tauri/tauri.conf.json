{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThermoShift",
  "version": "2.8.2",
  "identifier": "in.sanskar.thermoshift",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThermoShift",
        "width": 1120,
        "height": 760,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Precise offline temperature conversion",
    "longDescription": "ThermoShift is a private, offline-first temperature converter for modern web, desktop, and mobile platforms.",
    "copyright": "Copyright © 2026 Sanskar"
  }
}
