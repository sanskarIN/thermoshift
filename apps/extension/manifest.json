{
  "manifest_version": 3,
  "name": "ThermoShift",
  "short_name": "ThermoShift",
  "version": "0.1.0",
  "description": "Private, offline temperature conversion powered by ThermoShift's canonical Rust engine.",
  "action": {
    "default_title": "ThermoShift",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
